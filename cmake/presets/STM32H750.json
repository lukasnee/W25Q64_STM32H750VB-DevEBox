{
    "version": 10,
    "include": [
        "base.json"
    ],
    "configurePresets": [
        {
            "name": "toolchain-STM32H750",
            "hidden": true,
            "toolchainFile": "${fileDir}/../toolchains/arm-none-eabi-gcc.STM32H750.cmake"
        },
        {
            "name": "STM32H750-dbg",
            "inherits": [
                "build_dir",
                "ninja",
                "dbg",
                "toolchain-STM32H750"
            ]
        },
        {
            "name": "STM32H750-rel",
            "inherits": [
                "build_dir",
                "ninja",
                "rel",
                "toolchain-STM32H750"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "STM32H750-dbg",
            "configurePreset": "STM32H750-dbg"
        },
        {
            "name": "STM32H750-rel",
            "configurePreset": "STM32H750-rel"
        }
    ],
    "workflowPresets": [
        {
            "name": "STM32H750-dbg",
            "steps": [
                {
                    "type": "configure",
                    "name": "STM32H750-dbg"
                },
                {
                    "type": "build",
                    "name": "STM32H750-dbg"
                }
            ]
        },
        {
            "name": "STM32H750-rel",
            "steps": [
                {
                    "type": "configure",
                    "name": "STM32H750-rel"
                },
                {
                    "type": "build",
                    "name": "STM32H750-rel"
                }
            ]
        }
    ]
}